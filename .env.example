# Neon PostgreSQL connection string. Used by Workers and Drizzle Kit.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/flakecheck?sslmode=require

# 256-bit-or-longer secret used to sign 30-day session JWTs.
JWT_SECRET=replace-with-a-long-random-secret

# Resend passwordless OTP delivery.
RESEND_API_KEY=re_replace_with_resend_secret
RESEND_FROM_EMAIL=FlakeCheck <noreply@example.com>

# Optional OAuth applications. Callback URLs use PUBLIC_APP_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_APP_URL=https://flakecheck.example.com

# Set to true locally when diagnosing OTP request latency; keep disabled in production.
AUTH_TIMING_DEBUG=false

# Optional outbound notifications for flake and graduation events.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# JSON map of canonical owner/name repositories to SHA-256 token digests.
# Store digests, never plaintext repository tokens.
FLAKECHECK_PROJECT_TOKENS={"acme/payments":"replace-with-64-char-sha256-digest"}
