{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flakecheck-gateway-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@flakecheck/shared-kernel": "../../packages/shared-kernel/src/index.ts"
  },
  "vars": {
    "SERVICE_NAME": "gateway-service",
    "RATE_LIMIT_WINDOW_MS": "60000",
    "RATE_LIMIT_AUTH_MAX": "20",
    "RATE_LIMIT_INGEST_MAX": "120",
    "RATE_LIMIT_BADGE_MAX": "300",
    "RATE_LIMIT_CRON_MAX": "10",
    "RATE_LIMIT_API_MAX": "180"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER_DO",
        "class_name": "RateLimiterDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-rate-limiter-do",
      "new_sqlite_classes": ["RateLimiterDO"]
    }
  ],
  "services": [
    {
	    "binding": "INGESTION_SERVICE",
	    "service": "flakecheck-ingestion-service"
    },
    {
	    "binding": "ANALYSIS_SERVICE",
	    "service": "flakecheck-analysis-service"
    },
    {
	    "binding": "QUARANTINE_SERVICE",
	    "service": "flakecheck-quarantine-service"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/api/*",
      "/health",
      "/ready",
      "/guides",
      "/guides/*",
      "/compare/*",
      "/changelog",
      "/docs/api",
      "/og/*",
      "/sitemap.xml",
      "/robots.txt",
      "/llms.txt"
    ]
  },
  "env": {
    "staging": {
      "name": "flakecheck-gateway-staging",
      "vars": {
        "SERVICE_NAME": "gateway-service",
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "name": "flakecheck-gateway-service",
      "vars": {
        "SERVICE_NAME": "gateway-service",
        "ENVIRONMENT": "production"
      }
    }
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
