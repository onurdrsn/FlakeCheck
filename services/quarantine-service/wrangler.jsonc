{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flakecheck-quarantine-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@flakecheck/shared-kernel": "../../packages/shared-kernel/src/index.ts"
  },
  "vars": {
    "SERVICE_NAME": "quarantine-service"
  },
  "routes": [
    {
      "pattern": "quarantine.flakecheck.onurd.com.tr",
      "custom_domain": true
    }
  ],
  "observability": {
          "enabled": false,
          "head_sampling_rate": 1,
          "redact_query_string": false,
          "logs": {
                  "enabled": true,
                  "head_sampling_rate": 1,
                  "invocation_logs": true,
                  "persist": true
          },
          "traces": {
                  "enabled": true,
                  "head_sampling_rate": 1,
                  "persist": true
          },
          "issues": {
                  "enabled": true
          }
  }
}
